# -----------------
# Bashrc
# -----------------

# Guard clause: terminate execution immediately if shell is non-interactive
[[ $- == *i* ]] || return

# History configuration
HISTFILESIZE=100000
HISTSIZE=10000

# Shell behavioral options
shopt -s histappend
shopt -s extglob
shopt -s globstar
shopt -s checkjobs

# PATH
export PATH="${PATH}:${HOME}/.local/bin:${HOME}/.npm-global/bin"
export PS1="\n\[\033[1;32m\]  [\u]  [\w] \$ \[\033[0m\]"

# Node Package Manager configuration
export NPM_CONFIG_PREFIX="${HOME}/.npm-global"

# -----------------
# Nix-related
# -----------------

export NIX_DOTFILES="${HOME}/nix-dotfiles"

alias n-clean="time { sudo nix-collect-garbage -d && nix-collect-garbage -d ; }"
alias n-optimise="time { sudo nix-store --optimise ; }"

function n-rebuild() {
	time {
		local dotfiles="${NIX_DOTFILES:-"${HOME}/nix-dotfiles"}"
		local host="${1:-"$(hostname)"}"

		sudo nixos-rebuild switch --flake "${dotfiles}#${host}"
	}
}

# -----------------
# General Utility
# -----------------

function extract() {
	if [[ -f $1 ]]; then
		case "$1" in
		*.tar.bz2) tar xvjf "$1" ;;
		*.tar.gz) tar xvzf "$1" ;;
		*.tar.zst | *.tzst) tar --zstd -xvf "$1" ;;
		*.tar.xz) tar xvf "$1" ;;
		*.tar) tar xvf "$1" ;;
		*.tgz) tar xvf "$1" ;;
		*.zst) unzstd "$1" ;;
		*.xz) unxz "$1" ;;
		*.gz) gunzip "$1" ;;
		*.zip) unzip "$1" ;;
		*.rar) unrar x "$1" ;;
		*.bz2) bzip2 -d "$1" ;;
		*.lzma) unlzma "$1" ;;
		*.Z) uncompress "$1" ;;
		*.7z) 7z x "$1" ;;
		*.deb) ar x -- "$1" ;;
		*) echo "'$1' cannot be extracted via extract." ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}

function compress() {
	if [[ $# -ge 2 ]]; then
		local file="$1"
		shift
		case "$file" in
		*.tar) tar cf "$file" "$@" ;;
		*.tar.bz2) tar cjf "$file" "$@" ;;
		*.tar.xz) tar cJf "$file" "$@" ;;
		*.tar.gz | *.tgz) tar czf "$file" "$@" ;;
		*.tar.zst | *.tzst) tar --zstd -cf "$file" "$@" ;;
		*.zip) zip -r "$file" "$@" ;;
		*.rar) rar a "$file" "$@" ;;
		*)
			if command -v zstd >/dev/null 2>&1; then
				tar --zstd -cf "${file}.tar.zst" "$@"
			else
				tar czf "${file}.tar.gz" "$@"
			fi
			;;
		esac
	else
		echo "usage: compress <archive[.tar.zst|.tar.gz|...]> <file...>"
	fi
}

function fsize() {
	if du -b /dev/null >/dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ $# -gt 0 ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}

function killbyname() {
	local pid
	pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')

	if [[ -n "$pid" ]]; then
		xargs kill "-${1:-9}" <<<"$pid"
	fi
}

# Headless TTY1 Wayland Session Autostart
if [ "$(tty)" = "/dev/tty1" ]; then
	exec start-hyprland
fi
