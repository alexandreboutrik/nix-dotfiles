export PATH="${PATH}:${HOME}/.local/bin:${HOME}/.npm-global/bin"
export PS1="\n\[\033[1;32m\]  [\u]  [\w] \$ \[\033[0m\]"

mkdir -p ~/.npm-global
npm config set prefix '~/.npm-global'

# Nix-related

export NIX_DOTFILES="${HOME}/nix-dotfiles"

alias n-clean="time { sudo nix-collect-garbage -d && nix-collect-garbage -d ; }"
alias n-optimise="time { sudo nix-store --optimise ; }"

function n-update() {
	local dotfiles="${NIX_DOTFILES:-"${HOME}/nix-dotfiles"}"
	local host=""
	local auto_yes=false

	for arg in "$@"; do
		case "${arg}" in
		-y | --yes)
			auto_yes=true
			;;
		*)
			if [[ -z "${host}" ]]; then
				host="${arg}"
			fi
			;;
		esac
	done

	host="${host:-"$(hostname)"}"

	local RED='\033[0;31m'
	local GREEN='\033[1;32m'
	local YELLOW='\033[1;33m'
	local NC='\033[0m'

	subtext() {
		printf "%b--> %s%b\n" "${YELLOW}" "${1}" "${NC}"
	}

	if [[ ! -d "${dotfiles}" || ! -f "${dotfiles}/flake.lock" ]]; then
		printf "%bError:%b Flake repository or flake.lock not found at '%s'.\n" "${RED}" "${NC}" "${dotfiles}"
		return 1
	fi

	local OLD_NIXPKGS_REV OLD_HM_REV
	OLD_NIXPKGS_REV=$(nix flake metadata "${dotfiles}" --json | jq -r '.locks.nodes.nixpkgs.locked.rev // empty')
	OLD_HM_REV=$(nix flake metadata "${dotfiles}" --json | jq -r '.locks.nodes["home-manager"].locked.rev // empty')
	subtext "Current nixpkgs commit:      ${OLD_NIXPKGS_REV:-unknown}"
	subtext "Current home-manager commit: ${OLD_HM_REV:-unknown}"

	subtext "Updating flake inputs (nixpkgs & home-manager)..."
	nix flake update --flake "${dotfiles}"

	local NEW_NIXPKGS_REV NEW_HM_REV
	NEW_NIXPKGS_REV=$(nix flake metadata "${dotfiles}" --json | jq -r '.locks.nodes.nixpkgs.locked.rev // empty')
	NEW_HM_REV=$(nix flake metadata "${dotfiles}" --json | jq -r '.locks.nodes["home-manager"].locked.rev // empty')
	subtext "Target nixpkgs commit:       ${NEW_NIXPKGS_REV:-unknown}"
	subtext "Target home-manager commit:  ${NEW_HM_REV:-unknown}"

	if git -C "${dotfiles}" diff --quiet flake.lock; then
		printf "%bNo upstream updates found.%b flake.lock is already at the latest revision.\n" "${GREEN}" "${NC}"
		return 0
	fi

	subtext "Building closure (dry run: no activation) for host '${host}'..."
	local OUT_LINK="/tmp/result-check"
	rm -f "${OUT_LINK}"

	if ! nix build "${dotfiles}#nixosConfigurations.${host}.config.system.build.toplevel" --out-link "${OUT_LINK}"; then
		printf "%bBuild failed.%b Reverting lockfile changes.\n" "${RED}" "${NC}"
		git -C "${dotfiles}" restore flake.lock
		rm -f "${OUT_LINK}"
		return 1
	fi

	subtext "Package version comparison (nvd)"
	nvd diff /run/current-system "${OUT_LINK}"
	rm -f "${OUT_LINK}"

	local CONFIRM
	if [[ "${auto_yes}" == true ]]; then
		printf "%bAutomatic confirmation flag (-y) detected. Applying updates...%b\n" "${GREEN}" "${NC}"
		CONFIRM="y"
	else
		read -rp "Would you like to keep these flake updates? [y/N]: " CONFIRM
	fi

	if [[ "${CONFIRM}" =~ ^[Yy]$ ]]; then
		printf "%bUpdated flake.lock retained.%b\n" "${GREEN}" "${NC}"
		n-rebuild "${host}"
	else
		subtext "Reverting flake.lock to previous state..."
		git -C "${dotfiles}" restore flake.lock
		printf "%bChanges discarded. Your system and repository are untouched.%b\n" "${GREEN}" "${NC}"
	fi
}

function n-rebuild() {
	time {
		local dotfiles="${NIX_DOTFILES:-"${HOME}/nix-dotfiles"}"
		local host="${1:-"$(hostname)"}"

		sudo nixos-rebuild switch --flake "${dotfiles}#${host}"
	}
}

# Utility functions

function extract() {
	if [[ -f $1 ]]; then
		case "$1" in
		*.tar.bz2) tar xvjf "$1" ;;
		*.tar.gz) tar xvzf "$1" ;;
		*.tar.xz) tar xvf "$1" ;;
		*.tar) tar xvf "$1" ;;
		*.tgz) tar xvf "$1" ;;
		*.xz) tar xvf "$1" ;;
		*.gz) gunzip "$1" ;;
		*.zip) unzip "$1" ;;
		*.rar) unrar x "$1" ;;
		*.bz2) bzip2 -d "$1" ;;
		*.lzma) unlzma "$1" ;;
		*.Z) uncompress "$1" ;;
		*.7z) 7z x "$1" ;;
		*.deb) ar x ./"$1" ;;
		*) echo "'$1' cannot be extracted via extract." ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}

function compress() {
	if [[ -n "$1" ]]; then
		FILE=$1
		case $FILE in
		*.tar) shift && tar cf $FILE $* ;;
		*.tar.bz2) shift && tar cjf $FILE $* ;;
		*.tar.xz) shift && tar cjf $FILE $* ;;
		*.tar.gz) shift && tar czf $FILE $* ;;
		*.tgz) shift && tar czf $FILE $* ;;
		*.zip) shift && zip -r $FILE $* ;;
		*.rar) shift && rar $FILE $* ;;
		esac
	else
		echo "usage: compress <foo.tar.gz> ./foo ./bar"
	fi
}

function fsize() {
	if du -b /dev/null >/dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}

function killbyname() {
	local pid
	pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')

	if [ "x$pid" != "x" ]; then
		echo $pid | xargs kill -${1:-9}
	fi
}

if [ "$(tty)" = "/dev/tty1" ]; then
	exec start-hyprland
fi
